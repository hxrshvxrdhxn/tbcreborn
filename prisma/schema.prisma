generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  date        String
  category    String
  readTime    String
  excerpt     String
  content     String
  status      String   @default("published")
  publishedAt String?
  seoTitle      String?
  seoDescription String?
  pillar        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ContactQuery {
  id           String   @id @default(cuid())
  name         String
  company      String
  email        String
  phone        String?
  service      String
  budget       String?
  message      String
  landingPage  String?
  referrerPath String?
  createdAt    DateTime @default(now())
}

model HowToGuide {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  seoTitle      String?
  seoDescription String?
  pillar        String?
}

model HowToRequest {
  id        String   @id @default(cuid())
  query     String
  email     String
  createdAt DateTime @default(now())
}

// ── Website visitor analytics (cookieless) ──
// One row per visitor per day. `visitor` is a one-way hash of IP + user agent with a salt that
// changes daily, so nobody can be followed across days and no IP address is stored.
model SiteVisitor {
  id        String   @id @default(cuid())
  day       String   // YYYY-MM-DD, India time
  visitor   String
  isNew     Boolean  // first visit from this browser (localStorage flag, no cookie)
  views     Int      @default(1)
  landing   String
  referrer  String?
  country   String?
  device    String?
  firstSeen DateTime @default(now())
  lastSeen  DateTime @updatedAt

  @@unique([day, visitor])
  @@index([day])
}

model SitePageDay {
  day   String
  path  String
  views Int    @default(1)

  @@id([day, path])
}

// Real-user Core Web Vitals samples (LCP, INP, CLS, FCP, TTFB), summarised in the daily email.
model SiteVital {
  id     String   @id @default(cuid())
  day    String
  metric String
  value  Float
  path   String
  device String?
  at     DateTime @default(now())

  @@index([day, metric])
}
